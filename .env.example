# ---------------------------------------------------------------------------
# Stellar / Soroban
# ---------------------------------------------------------------------------

# Soroban RPC + Horizon endpoints. Defaults point at Stellar Testnet.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Contract id (C...) printed by `pnpm deploy:testnet`.
# Without it the app runs in local-only mode and cannot anchor receipts.
NEXT_PUBLIC_STELLARPROOF_CONTRACT_ID=

# Secret key (S...) of a Friendbot-funded Stellar Testnet account used to deploy.
# Never expose this to the browser: it is only read by scripts/deploy.ts.
STELLAR_DEPLOYER_SECRET=

# Optional overrides for the deploy script
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# STELLARPROOF_WASM_PATH=target/wasm32v1-none/release/stellarproof_receipts.wasm

# ---------------------------------------------------------------------------
# AI, storage and database (optional; the app degrades gracefully without them)
# ---------------------------------------------------------------------------

# https://aistudio.google.com/
GEMINI_API_KEY=

# https://pinata.cloud/
PINATA_JWT=

# https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
